# Base URL of the backend API (no trailing slash).
#
# LOCAL DEV: leave EMPTY to use the Vite dev proxy (/api -> https://localhost:7285,
# self-signed certs accepted). See vite.config.js server.proxy.
VITE_API_URL=

# PRODUCTION: set the absolute origin, e.g. VITE_API_URL=https://api.koifengshui.vn
# Cross-origin deployments require the backend to send CORS headers for the
# frontend origin.
